        <mxCell id="up-starting" value="STARTING&#xa;启动目标服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="270" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="up-health" value="HEALTH_CHECKING&#xa;版本 / Schema / 运行态 / ClamAV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="270" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="up-committed" value="COMMITTED&#xa;安装状态已提交" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7E1CD;strokeColor=#2D8A4F;fontSize=11;arcSize=10;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="270" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="up-rejected" value="REJECTED&#xa;接收校验失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="205" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="up-cancelled" value="CANCELLED&#xa;响应未完整发送" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="205" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="up-schedule-failed" value="SCHEDULE_FAILED&#xa;updater 调度失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="205" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="up-failed" value="FAILED&#xa;重新校验、准备或任一执行阶段失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;arcSize=10;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="515" y="420" width="280" height="55" as="geometry" /></mxCell>

