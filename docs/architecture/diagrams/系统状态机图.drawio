        <mxCell id="up-note" value="终态：REJECTED、CANCELLED、SCHEDULE_FAILED、COMMITTED、FAILED。在线升级不自动回滚；只有目标服务健康检查通过且数据库安装状态提交成功后，任务才进入 COMMITTED。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D4A72C;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="535" width="950" height="55" as="geometry" />
        </mxCell>
        <mxCell id="up-note2" value="失败结果记录失败阶段、原因、源版本和目标版本；主服务运行后将终态结果幂等写入操作日志。系统版本必须严格大于数据库中的当前版本，病毒库“逢 4 跳过”规则不适用于系统升级。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="610" width="950" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
