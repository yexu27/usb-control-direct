        <mxCell id="e-sc-ri" value="发现病毒文件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#D4A72C;fontSize=10;" edge="1" parent="1">
