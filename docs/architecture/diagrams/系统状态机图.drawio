        <mxCell id="up-title" value="系统程序升级状态机" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1140" height="32" as="geometry" />
        </mxCell>
        <mxCell id="up-sub" value="主服务负责接收、校验、响应和调度；独立 updater 负责重新校验、安装、迁移、启动、健康检查和安装状态提交。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="1080" height="22" as="geometry" />
        </mxCell>
        <mxCell id="up-start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="55" y="130" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="up-validating" value="VALIDATING&#xa;暂存与接收校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="115" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="up-prepared" value="PREPARED&#xa;等待响应发送结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="115" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="up-accepted" value="ACCEPTED&#xa;允许调度 updater" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="115" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="up-stopping" value="STOPPING&#xa;停止主服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="115" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="up-installing" value="INSTALLING&#xa;安装目标 DEB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;arcSize=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="115" width="150" height="50" as="geometry" /></mxCell>
