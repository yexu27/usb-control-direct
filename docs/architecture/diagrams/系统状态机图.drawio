        <mxCell id="e-up-rejected" value="校验失败" edge="1" parent="1" source="up-validating" target="up-rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-up-prepared" value="校验通过" edge="1" parent="1" source="up-validating" target="up-prepared" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1F77B4;fontSize=10;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-up-cancelled" value="发送失败" edge="1" parent="1" source="up-prepared" target="up-cancelled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=10;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-up-accepted" value="响应发送成功" edge="1" parent="1" source="up-prepared" target="up-accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1F77B4;fontSize=10;"><mxGeometry relative="1" as="geometry" /></mxCell>
