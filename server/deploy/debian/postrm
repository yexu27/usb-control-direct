#!/usr/bin/env bash
set -euo pipefail

action="${1:-remove}"

if [ "$action" = "remove" ] || [ "$action" = "purge" ]; then
  rm -f /etc/systemd/system/usb-control.service
  rm -rf /opt/usb-control

  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
  fi
fi

if [ "$action" = "purge" ]; then
  rm -rf /etc/usb-control
  rm -rf /var/lib/usb-control
  rm -rf /var/log/usb-control
  echo "usb-control postrm: purged all data"
else
  echo "usb-control postrm: preserved /var/lib/usb-control and /var/log/usb-control"
fi

exit 0
