#!/usr/bin/env bash
set -euo pipefail

action="${1:-remove}"

if [ "$action" = 'upgrade' ] && [ -e /run/usb-control-updater/managed ]; then
  exit 0
fi

case "$action" in
  remove|deconfigure|upgrade)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl stop usb-control.service
      if [ "$action" = 'remove' ]; then
        systemctl disable usb-control.service
      fi
    fi
    ;;
esac

exit 0
