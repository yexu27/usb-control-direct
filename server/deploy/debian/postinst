#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "usb-control postinst: $*" >&2
  exit 1
}

require_file() {
  test -f "$1" || fail "missing packaged default: $1"
}

install_missing() {
  source_path="$1"
  target_path="$2"
  mode="$3"
  require_file "$source_path"
  if [ -e "$target_path" ]; then
    return 0
  fi
  target_dir="$(dirname "$target_path")"
  target_name="$(basename "$target_path")"
  temporary="$target_dir/.${target_name}.postinst.$$"
  install -m "$mode" -o root -g root "$source_path" "$temporary"
  if [ -e "$target_path" ]; then
    rm -f "$temporary"
  else
    mv "$temporary" "$target_path"
  fi
}

replace_managed() {
  source_path="$1"
  target_path="$2"
  mode="$3"
  require_file "$source_path"
  target_dir="$(dirname "$target_path")"
  target_name="$(basename "$target_path")"
  temporary="$target_dir/.${target_name}.postinst.$$"
  install -m "$mode" -o root -g root "$source_path" "$temporary"
  mv -f "$temporary" "$target_path"
}

action="${1:-configure}"
if [ "$action" != 'configure' ]; then
  exit 0
fi

DEFAULTS=/opt/usb-control/defaults/etc/usb-control
install -d -m 0750 -o root -g root /etc/usb-control /etc/usb-control/keys
install -d -m 0700 -o root -g root /etc/usb-control/tls
install -d -m 0700 -o root -g root /var/lib/usb-control /var/lib/usb-control/upgrade
install -d -m 0755 -o root -g root /var/log/usb-control /var/log/usb-control/scan

for binary in usb-control usb-control-updater usb-control-db-migrate; do
  test -f "/opt/usb-control/bin/$binary" || fail "missing installed binary: $binary"
  chown root:root "/opt/usb-control/bin/$binary"
  chmod 0755 "/opt/usb-control/bin/$binary"
done

install_missing "$DEFAULTS/usb-control.toml" /etc/usb-control/usb-control.toml 0640
install_missing "$DEFAULTS/tls/server.crt" /etc/usb-control/tls/server.crt 0644
install_missing "$DEFAULTS/tls/server.key" /etc/usb-control/tls/server.key 0600
install_missing "$DEFAULTS/tls/server.crt.sha256" /etc/usb-control/tls/server.crt.sha256 0644
install_missing "$DEFAULTS/keys/license_verify.pub" /etc/usb-control/keys/license_verify.pub 0644
install_missing "$DEFAULTS/keys/sm4_policy.key" /etc/usb-control/keys/sm4_policy.key 0600
install_missing "$DEFAULTS/keys/sm2_policy.key" /etc/usb-control/keys/sm2_policy.key 0600
install_missing "$DEFAULTS/keys/sm2_policy.pub" /etc/usb-control/keys/sm2_policy.pub 0644
replace_managed "$DEFAULTS/keys/upgrade_verify.pub" /etc/usb-control/keys/upgrade_verify.pub 0644
replace_managed "$DEFAULTS/keys/upgrade_verify.id" /etc/usb-control/keys/upgrade_verify.id 0644

if [ -e /run/usb-control-updater/managed ]; then
  exit 0
fi

/opt/usb-control/bin/usb-control-updater finalize-install
exit 0
